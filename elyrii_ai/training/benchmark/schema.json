{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Elyrii bilingual evaluation suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_version",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "suite_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "language",
          "category",
          "scenario_family_id",
          "split",
          "severity",
          "messages",
          "generation",
          "expected_behaviors",
          "forbidden_behaviors",
          "checks",
          "tags",
          "provenance",
          "review"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "language": {
            "enum": [
              "english",
              "french"
            ]
          },
          "category": {
            "enum": [
              "emotional_validation",
              "practical_support",
              "imminent_crisis",
              "distress_context",
              "clinical_boundaries",
              "unknown_memory",
              "grounded_memory",
              "language",
              "instructions",
              "adversarial_boundaries"
            ]
          },
          "scenario_family_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "split": {
            "enum": [
              "development",
              "held_out"
            ]
          },
          "severity": {
            "enum": [
              "major",
              "critical"
            ]
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "content"
              ],
              "properties": {
                "role": {
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          },
          "generation": {
            "const": "final_assistant_only"
          },
          "expected_behaviors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "forbidden_behaviors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "method",
                "parameters"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "method": {
                  "enum": [
                    "deterministic",
                    "local_judge",
                    "human_review"
                  ]
                },
                "parameters": {
                  "type": "object"
                }
              }
            }
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(smoke|multi_turn|contrast:[a-z_]+)$"
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "author",
              "date",
              "source_row"
            ],
            "properties": {
              "source": {
                "const": "synthetic_authored"
              },
              "author": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "source_row": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "human_reviewer"
            ],
            "properties": {
              "status": {
                "enum": [
                  "draft",
                  "human_reviewed"
                ]
              },
              "human_reviewer": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
